# Copy to .env.local (never commit .env.local or real keys).
# Use the SAME Supabase project as mirna-admin:
# Supabase Dashboard → Project Settings → API (or Data API / API Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public client key: the legacy "anon" JWT key, or the newer "publishable"
# key (sb_publishable_…). Safe in the browser — Row Level Security limits it
# to active categories/products/images. (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# the name mirna-admin uses, is accepted as a fallback.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the storefront, used for canonical URLs, Open Graph,
# robots.txt and the sitemap. Defaults to http://localhost:3006.
NEXT_PUBLIC_SITE_URL=

# Optional. Active market from config/region.ts (default: AE → AED, en-AE, Asia/Dubai).
# NEXT_PUBLIC_REGION=AE

# Optional. WhatsApp number for the floating chat button, in international
# format (e.g. +971501234567). Used only while no WhatsApp number is published
# in mirna-admin (Settings → Contact information), which takes precedence.
# STORE_WHATSAPP_NUMBER=

# Optional, for `npm run db:types` only (not read by the app).
# SUPABASE_PROJECT_ID=

# --- Online payments (Stripe; mirna-admin migration 044) ---------------------
# Same Stripe account (and mode) as mirna-admin. Stripe Dashboard →
# Developers → API keys.
#
# Publishable key (pk_test_… / pk_live_…): safe in the browser, loads the
# Payment Element.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
#
# Server-only: creates PaymentIntents for the signed-in customer's own orders.
# NEVER add a NEXT_PUBLIC_ prefix. Prefer a restricted key (rk_…) with only
# "PaymentIntents: Write". Webhooks and refunds live in mirna-admin, so the
# webhook secret is NOT needed here.
STRIPE_SECRET_KEY=

# Optional, recommended. Confirms a paid order as soon as Stripe reports it
# (the customer is on the confirmation page), instead of waiting for the
# webhook: the storefront asks mirna-admin to re-read the payment from Stripe.
# ADMIN_URL is mirna-admin's origin; PAYMENTS_SYNC_SECRET must equal
# mirna-admin's. Server-only (no NEXT_PUBLIC_ prefix).
ADMIN_URL=
PAYMENTS_SYNC_SECRET=

# The storefront never uses the service role key. Do NOT add
# SUPABASE_SERVICE_ROLE_KEY here, and never with a NEXT_PUBLIC_ prefix.
